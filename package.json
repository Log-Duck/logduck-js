{
  "name": "logduck",
  "version": "2.1.2",
  "description": "Official JavaScript and TypeScript SDK for LogDuck event logging and notifications",
  "license": "MIT",
  "author": "LogDuck",
  "homepage": "https://logduck.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Log-Duck/logduck-js.git"
  },
  "bugs": {
    "url": "https://github.com/Log-Duck/logduck-js/issues"
  },
  "keywords": [
    "logging",
    "events",
    "notifications",
    "logduck",
    "observability",
    "analytics",
    "page views"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js",
      "require": "./dist/usage.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1"
  }
}
